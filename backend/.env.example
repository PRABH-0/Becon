# Environment mode: development | production | test
ENVIRONMENT=development

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# Database URL (SQLite default: sqlite:///./becon.db; or PostgreSQL: postgresql://...)
DATABASE_URL=sqlite:///./becon.db

# Ingest API Secret Token for securing POST /api/ingest
INGEST_API_TOKEN=

# Allowed CORS Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Swagger Docs enabled (true/false)
ENABLE_DOCS=true

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Stale-while-revalidate TTL in seconds for persisted briefing cards (default: 1800)
FEED_CACHE_TTL_SECONDS=1800

# --- Rate Limiting & Abuse Controls (In-process; use Redis when scaled horizontally) ---
# Enable/disable in-process rate limits & Gemini daily caps (default: true)
RATE_LIMIT_ENABLED=true
# Max requests per minute per IP on public/unauthenticated endpoints (default: 30)
RATE_LIMIT_PUBLIC_PER_MIN=30
# Max requests per minute per authenticated user on AI-triggering endpoints (default: 10)
RATE_LIMIT_AUTH_AI_PER_MIN=10
# Max requests per minute per anonymous guest on AI-triggering endpoints (default: 2)
GUEST_AI_PER_MIN=2
# Hard daily (UTC) Gemini API call cap per full authenticated user (default: 25)
GEMINI_DAILY_CAP_PER_USER=25
# Hard daily (UTC) Gemini API call cap per anonymous guest (default: 3)
GEMINI_DAILY_CAP_GUEST=3
# Hard daily (UTC) Gemini API call cap shared across all anonymous guests (default: 30)
GEMINI_DAILY_CAP_ALL_GUESTS=30
# Hard daily (UTC) Gemini API call cap globally per process (default: 200)
GEMINI_DAILY_CAP_GLOBAL=200
# Max Gemini card-synthesis calls per ingestion run (default: 25)
INGEST_MAX_GEMINI_CALLS_PER_RUN=25
# Max output tokens per Gemini call by workflow (card=650, chat=400, match_topics=200)
GEMINI_MAX_OUTPUT_TOKENS_CARD=650
GEMINI_MAX_OUTPUT_TOKENS_CHAT=400
GEMINI_MAX_OUTPUT_TOKENS_MATCH_TOPICS=200
# Comma-separated trusted reverse proxy IPs allowed to supply X-Forwarded-For (empty = ignore XFF)
TRUSTED_PROXIES=

# --- Supabase Authentication (Primary Identity Provider) ---
# Project URL (Required in production; e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Legacy JWT secret for HS256 projects (Optional; only needed if project uses legacy symmetric signing instead of ECC/RSA JWKS)
SUPABASE_JWT_SECRET=

# Supabase Service Role Key / Secret Key (Optional; backend only, used for admin tasks like user account deletion)
# CRITICAL: NEVER share this key with the frontend or commit to version control.
SUPABASE_SERVICE_ROLE_KEY=

# Expected JWT audience claim (defaults to 'authenticated')
SUPABASE_JWT_AUDIENCE=authenticated
